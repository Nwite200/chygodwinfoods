<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <rect width="400" height="400" fill="#F8FAFC"/>
  <circle cx="200" cy="200" r="140" fill="#FEE2E2" opacity="0.4"/>
  <!-- Trapezoid tin can -->
