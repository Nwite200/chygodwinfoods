# Admin Console login
# These are fetched from your hosting environment (e.g. Netlify env vars) at runtime.
# Generate the hash with:  node scripts/make-admin-hash.js   (type the password when prompted)
# Format:  ADMIN_PASSWORD_HASH=<16-byte-salt-hex>:<scrypt-64-byte-hex>

ADMIN_EMAIL=     # e.g. admin@yourstore.com
ADMIN_PASSWORD_HASH=