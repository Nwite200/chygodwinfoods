# Admin Console login
# These are fetched from your hosting environment (e.g. Cloudflare Pages env vars) at runtime.
# ChyGodwin Foodstuffs — environment variables
#
# ADMIN credentials are SERVER-SIDE ONLY: read by functions/api/admin-login.js.
# They never reach the browser bundle. Set them in Cloudflare Pages:
#   Pages → Settings → Environment variables → Add a variable
# Generate the hash with:  node scripts/make-admin-hash.js   (type the password when prompted)
# Format:  ADMIN_PASSWORD_HASH=<16-byte-salt-hex>:<scrypt-64-byte-hex>
#
# Rate limiting uses Cloudflare KV. Bind a KV namespace:
#   Pages → Settings → Functions → KV namespace bindings
#   Variable name: ADMIN_LIMITS_KV
#
# The VITE_ADMIN_EMAIL / VITE_ADMIN_PASSWORD_HASH names still work as a temporary
# fallback — delete them once the unprefixed ADMIN_* names are confirmed working.
#
# Client-side (must be VITE_ prefixed to reach the browser):
VITE_SUPABASE_URL=      # https://<project-ref>.supabase.co  (the API URL, NOT the dashboard URL)
VITE_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (safe to expose)

# Server-side admin login (NOT exposed to the browser):
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=